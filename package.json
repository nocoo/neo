{
  "name": "neo",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 7026",
    "build": "next build --webpack",
    "start": "next start -p 7026",
    "lint": "biome check --error-on-warnings --max-diagnostics=500 .",
    "lint:fix": "biome check --write --error-on-warnings --max-diagnostics=500 .",
    "format": "biome format --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run --exclude 'tests/api/**'",
    "test:unit:coverage": "vitest run --exclude 'tests/api/**' --coverage",
    "test:api": "vitest run tests/api",
    "test:e2e": "bun run scripts/run-e2e.ts",
    "test:e2e:pw": "bun x playwright test",
    "test:e2e:pw:ui": "bun x playwright test --ui",
    "test:e2e:bdd": "bunx playwright test",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && bun run --cwd worker typecheck",
    "test:security": "bun scripts/run-security.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@radix-ui/react-avatar": "^1.2.3",
    "@radix-ui/react-collapsible": "^1.1.17",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.13",
    "@serwist/next": "^9.5.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "lucide-react": "1.25.0",
    "next": "16.2.11",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "postcss": "^8.5.21",
    "serwist": "^9.5.12",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,json}": [
      "biome check --write --error-on-warnings --max-diagnostics=500 --no-errors-on-unmatched"
    ]
  },
  "browserslist": [
    "chrome >= 96",
    "firefox >= 95",
    "safari >= 15.4",
    "edge >= 96"
  ],
  "overrides": {
    "@babel/core": "^7.29.6",
    "brace-expansion": "^5.0.7",
    "cookie": "^0.7.0",
    "esbuild": "^0.28.1",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.21",
    "sharp": "^0.35.0",
    "vite": "^8.0.16",
    "ws": "^8.21.0",
    "yaml": "^2.8.3"
  }
}
