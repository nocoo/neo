#!/usr/bin/env sh

# === System0 gate: pre-push ===
# Verifies exactly the commits being pushed (never the working tree): one
# exported snapshot per pushed OID, then S1, S2, G1, L1, G2, B1, L3 and L4.
# Deleted refs are skipped; a new branch scans "<oid> --not --remotes".
set -e

zero=0000000000000000000000000000000000000000

command -v git >/dev/null 2>&1 || {
	echo "pre-push: git is required" >&2
	exit 1
}
command -v bun >/dev/null 2>&1 || {
	echo "pre-push: bun is required" >&2
	exit 1
}
command -v tar >/dev/null 2>&1 || {
	echo "pre-push: tar is required" >&2
	exit 1
}

repo=$(git rev-parse --show-toplevel)

tmp_root=$(mktemp -d "${TMPDIR:-/tmp}"/neo-push-XXXXXX)
snapshots="$tmp_root/snapshots"
mkdir -p "$snapshots"

cleanup() {
	status=$?
	trap - EXIT INT TERM HUP
	rm -rf "$tmp_root" || :
	exit "$status"
}
trap cleanup EXIT
trap "exit 130" INT
trap "exit 143" TERM
trap "exit 129" HUP

# Read every ref before running anything: the gate steps inherit stdin, and a
# step that reads it would swallow the refs that have not been verified yet.
refs_file="$tmp_root/refs"
cat >"$refs_file"
if [ ! -s "$refs_file" ]; then
	echo "pre-push: no refs on stdin — this hook only runs from 'git push'" >&2
	exit 1
fi

# A pushed commit that changes dependencies needs its own install. On failure say
# why, because the raw registry error is unhelpful: the lockfile is authoritative
# and a blocked registry is an environment problem, not a code problem.
install_in() {
	if ! (cd "$1" && bun install --frozen-lockfile); then
		echo "pre-push: frozen install failed in $1" >&2
		echo "pre-push: the pushed lockfile is authoritative; if the registry is blocked, point BUN_CONFIG_REGISTRY at a reachable mirror and retry" >&2
		exit 1
	fi
}

link_tree() {
	from=$1
	to=$2
	mkdir -p "$to/node_modules"
	for entry in "$from/node_modules"/*; do
		[ -e "$entry" ] || continue
		ln -s "$entry" "$to/node_modules/${entry##*/}"
	done
	if [ -d "$from/node_modules/.bin" ]; then
		ln -s "$from/node_modules/.bin" "$to/node_modules/.bin"
	fi
}

# The snapshot must run against the dependencies its own manifests declare.
prepare_dependencies() {
	snapshot=$1
	if cmp -s "$snapshot/package.json" "$repo/package.json" &&
		cmp -s "$snapshot/bun.lock" "$repo/bun.lock" &&
		[ -d "$repo/node_modules" ]; then
		link_tree "$repo" "$snapshot"
	else
		echo "▸ root manifests differ from the installed tree — frozen install in the snapshot"
		install_in "$snapshot"
	fi
	if [ -f "$snapshot/worker/package.json" ]; then
		if cmp -s "$snapshot/worker/package.json" "$repo/worker/package.json" &&
			cmp -s "$snapshot/worker/bun.lock" "$repo/worker/bun.lock" &&
			[ -d "$repo/worker/node_modules" ]; then
			link_tree "$repo/worker" "$snapshot/worker"
		else
			echo "▸ worker manifests differ from the installed tree — frozen install in the snapshot"
			install_in "$snapshot/worker"
		fi
	fi
}

status=0
verified=
count=0
deleted=0

while read -r local_ref local_sha remote_ref remote_sha; do
	[ -n "$local_sha" ] || continue
	if [ "$local_sha" = "$zero" ]; then
		echo "▸ $remote_ref: deletion, no source checks"
		deleted=$((deleted + 1))
		continue
	fi

	commit=$(git rev-parse --verify "$local_sha^{commit}")
	case " $verified " in
	*" $commit "*)
		echo "▸ $remote_ref: $commit already verified in this push"
		continue
		;;
	esac
	verified="$verified $commit"
	count=$((count + 1))

	if [ "$remote_sha" = "$zero" ]; then
		range="$commit --not --remotes"
		echo "▸ $remote_ref: $commit (new ref, secret range: $range)"
	else
		range="$remote_sha..$commit"
		echo "▸ $remote_ref: $commit (secret range: $range)"
	fi

	snapshot="$snapshots/$(printf '%s' "$commit" | cut -c1-12)"
	mkdir -p "$snapshot"
	git archive "$commit" >"$tmp_root/archive.tar"
	tar -xf "$tmp_root/archive.tar" -C "$snapshot"
	prepare_dependencies "$snapshot"

	if ! (
		cd "$snapshot"
		unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX
		export GATE_GIT_ROOT="$repo"
		export GATE_SNAPSHOT_ROOT="$snapshot"
		export GATE_CONTENT_SHA="$commit"
		export XDG_CACHE_HOME="$tmp_root/cache"
		export XDG_STATE_HOME="$tmp_root/cache"
		mkdir -p "$XDG_CACHE_HOME"
		bun run scripts/quality/gate.ts --stage=pre-push --g1-range="$range"
	); then
		status=1
	fi
done <"$refs_file"

if [ "$count" -eq 0 ] && [ "$deleted" -eq 0 ]; then
	echo "pre-push: no source ref found in the push input" >&2
	exit 1
fi

exit $status
