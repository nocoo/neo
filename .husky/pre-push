#!/usr/bin/env sh

# === System0 gate: pre-push ===
# Verifies exactly the commits being pushed (never the working tree): one
# exported snapshot per pushed OID, then S1, S2, G1, L1, G2, B1, L3 and L4.
# Deleted refs are skipped. G1 scans one range per pushed ref: a new ref scans
# the full history reachable from its OID, an existing ref scans
# "<remote-sha>..<local-sha>".
set -e

zero=0000000000000000000000000000000000000000
hook_start=$(date +%s)

command -v git >/dev/null 2>&1 || {
	echo "pre-push: git is required" >&2
	exit 1
}
command -v bun >/dev/null 2>&1 || {
	echo "pre-push: bun is required" >&2
	exit 1
}
command -v tar >/dev/null 2>&1 || {
	echo "pre-push: tar is required" >&2
	exit 1
}

repo=$(git rev-parse --show-toplevel)

tmp_root=$(mktemp -d "${TMPDIR:-/tmp}"/neo-push-XXXXXX)
snapshots="$tmp_root/snapshots"
mkdir -p "$snapshots"

cleanup() {
	status=$?
	trap - EXIT INT TERM HUP
	rm -rf "$tmp_root" || :
	elapsed=$(( $(date +%s) - hook_start ))
	echo "pre-push: wall ${elapsed}s (hard budget 300s)"
	if [ "$status" -eq 0 ] && [ "$elapsed" -gt 300 ]; then
		echo "pre-push: wall time ${elapsed}s exceeds the 300s hard budget" >&2
		status=1
	fi
	exit "$status"
}
trap cleanup EXIT
trap "exit 130" INT
trap "exit 143" TERM
trap "exit 129" HUP

# Read every ref before running anything: the gate steps inherit stdin, and a
# step that reads it would swallow the refs that have not been verified yet.
refs_file="$tmp_root/refs"
cat >"$refs_file"
if [ ! -s "$refs_file" ]; then
	echo "pre-push: no refs on stdin — this hook only runs from 'git push'" >&2
	exit 1
fi

# The pushed snapshot must run against exactly the dependencies its own lockfile
# describes. Reusing the worktree's node_modules only compared manifests; it
# could not prove the installed versions matched the pushed lockfile.
install_in() {
	if ! (cd "$1" && bun install --frozen-lockfile --ignore-scripts); then
		echo "pre-push: frozen install failed in $1" >&2
		echo "pre-push: the pushed lockfile is authoritative; if the registry is blocked, point BUN_CONFIG_REGISTRY at a reachable mirror and retry" >&2
		exit 1
	fi
}

status=0
deleted=0
ranges="$tmp_root/ranges"
commits="$tmp_root/commits"
: >"$ranges"

while read -r local_ref local_sha remote_ref remote_sha; do
	[ -n "$local_sha" ] || continue
	if [ "$local_sha" = "$zero" ]; then
		echo "▸ $remote_ref: deletion, no source checks"
		deleted=$((deleted + 1))
		continue
	fi

	commit=$(git rev-parse --verify "$local_sha^{commit}")
	if [ "$remote_sha" = "$zero" ]; then
		range="$commit"
	else
		range="$remote_sha..$commit"
	fi
	echo "▸ $remote_ref: $commit (secret range: $range)"
	printf '%s\t%s\n' "$commit" "$range" >>"$ranges"
done <"$refs_file"

awk -F '\t' '!seen[$1]++ {print $1}' "$ranges" >"$commits"
count=$(wc -l <"$commits" | tr -d ' ')

while read -r commit; do
	[ -n "$commit" ] || continue

	g1_args=
	for range in $(awk -F '\t' -v commit="$commit" '$1 == commit {print $2}' "$ranges" | sort -u); do
		g1_args="$g1_args --g1-range=$range"
	done

	snapshot="$snapshots/$(printf '%s' "$commit" | cut -c1-12)"
	mkdir -p "$snapshot"
	git archive "$commit" >"$tmp_root/archive.tar"
	tar -xf "$tmp_root/archive.tar" -C "$snapshot"
	install_in "$snapshot"
	if [ -f "$snapshot/worker/package.json" ] && [ -f "$snapshot/worker/bun.lock" ]; then
		install_in "$snapshot/worker"
	fi

	if ! (
		cd "$snapshot"
		unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX
		export GATE_GIT_ROOT="$repo"
		export GATE_SNAPSHOT_ROOT="$snapshot"
		export GATE_CONTENT_SHA="$commit"
		export GATE_PREP_SECONDS=$(( $(date +%s) - hook_start ))
		export XDG_CACHE_HOME="$tmp_root/cache"
		export XDG_STATE_HOME="$tmp_root/cache"
		mkdir -p "$XDG_CACHE_HOME"
		bun run scripts/quality/gate.ts --stage=pre-push $g1_args
	); then
		status=1
	fi
done <"$commits"

if [ "$count" -eq 0 ] && [ "$deleted" -eq 0 ]; then
	echo "pre-push: no source ref found in the push input" >&2
	exit 1
fi

exit $status
