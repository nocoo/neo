#!/usr/bin/env sh

# pre-commit: L1 Unit Tests (with coverage) + G1 Static Analysis (Biome + TypeScript)
#
# What is actually validated
# ──────────────────────────
# The gates run against a materialised snapshot of the git INDEX, not the
# working tree. That means a file that is fixed in the working copy but
# broken in the staged snapshot still fails — the commit only records the
# index, so the index is what must pass. `git checkout-index --prefix=…`
# writes every tracked file at its staged version into a temp directory,
# node_modules are symlinked in so bun/tsc/vitest resolve dependencies,
# and the read-only gates cd into that snapshot to run.
#
# Ordering
# ────────
# lint-staged is a writer (biome check --write mutates the working tree
# via git stash/restore). Run it FIRST, in the working tree, so it
# finishes before the snapshot is taken. Then take the snapshot from
# the fresh index and run the read-only gates in parallel.

STAGED_FILES=$(git diff --cached --name-only)

# G0: Verify lockfile in sync with package.json when either changes.
# Root and worker each have their own package.json + bun.lock; run the
# frozen install in whichever tree the staged change touches.
ROOT_PKG_CHANGES=$(echo "$STAGED_FILES" | grep -E "^(package\.json|bun\.lock)$" || true)
WORKER_PKG_CHANGES=$(echo "$STAGED_FILES" | grep -E "^worker/(package\.json|bun\.lock)$" || true)

if [ -n "$ROOT_PKG_CHANGES" ]; then
  bun install --frozen-lockfile 2>&1
  if [ $? -ne 0 ]; then
    echo "❌ pre-commit FAILED: Root lockfile out of sync. Run 'bun install' and commit bun.lock."
    exit 1
  fi
fi

if [ -n "$WORKER_PKG_CHANGES" ]; then
  bun install --cwd worker --frozen-lockfile 2>&1
  if [ $? -ne 0 ]; then
    echo "❌ pre-commit FAILED: Worker lockfile out of sync. Run 'bun install --cwd worker' and commit worker/bun.lock."
    exit 1
  fi
fi

# Detect code changes. Docs-only commits skip heavy gates.
# Keep this superset in sync with the BIOME_STAGED / TSC_AFFECTING matchers
# below and with the lint-staged glob in package.json.
CODE_CHANGES=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx|mts|cts|js|jsx|mjs|cjs|json)$' || true)
TSC_AFFECTING=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx|mts|cts)$|tsconfig.*\.json$' || true)
BIOME_STAGED=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx|mts|cts|js|jsx|mjs|cjs|json)$' || true)

if [ -z "$CODE_CHANGES" ]; then
  echo "⏭️  pre-commit: no code changes staged — skipping L1/G1a/G1b gates"
  exit 0
fi

# G1b (mutates the working tree): Biome strict on staged files only, via
# lint-staged. Runs against the working tree so autofixes can be re-staged.
# Must finish before we snapshot the index.
if [ -n "$BIOME_STAGED" ]; then
  bunx lint-staged 2>&1
  if [ $? -ne 0 ]; then
    echo "❌ pre-commit FAILED: Biome errors in staged files."
    exit 1
  fi
fi

# Materialise the INDEX (post-lint-staged) into a temp dir. Read-only gates
# operate against this snapshot, not the working tree — so uncommitted
# edits in the working copy can never sneak past a broken staged file.
SNAP_ROOT=$(mktemp -d -t neo-precommit-snap.XXXXXXXX)
if [ -z "$SNAP_ROOT" ] || [ ! -d "$SNAP_ROOT" ]; then
  echo "❌ pre-commit FAILED: could not create snapshot dir."
  exit 1
fi
trap 'rm -rf "$SNAP_ROOT"' EXIT INT TERM
# --prefix requires the trailing slash; -a materialises every tracked file.
git checkout-index --prefix="$SNAP_ROOT/" -a
if [ $? -ne 0 ]; then
  echo "❌ pre-commit FAILED: git checkout-index for snapshot."
  exit 1
fi
# Reuse the working tree's installed dependencies inside the snapshot;
# a fresh bun install per commit would be prohibitively slow.
ln -s "$(pwd)/node_modules" "$SNAP_ROOT/node_modules"
if [ -d worker/node_modules ]; then
  ln -s "$(pwd)/worker/node_modules" "$SNAP_ROOT/worker/node_modules"
fi

TMP_DIR=$(mktemp -d)
TEST_EXIT_FILE="$TMP_DIR/test_exit"
TSC_EXIT_FILE="$TMP_DIR/tsc_exit"

# L1 Unit Tests + coverage (thresholds enforced by vitest.config.ts) — read-only.
(
  cd "$SNAP_ROOT" && bun run test:unit:coverage 2>&1
  echo $? > "$TEST_EXIT_FILE"
) &
TEST_PID=$!

if [ -n "$TSC_AFFECTING" ]; then
  (
    # G1a: TypeScript strict (whole project — tsc needs complete context) — read-only.
    cd "$SNAP_ROOT" && bun run typecheck 2>&1
    echo $? > "$TSC_EXIT_FILE"
  ) &
  TSC_PID=$!
else
  echo 0 > "$TSC_EXIT_FILE"
  TSC_PID=""
fi

wait $TEST_PID
[ -n "$TSC_PID" ] && wait $TSC_PID

TEST_EXIT=$(cat "$TEST_EXIT_FILE")
TSC_EXIT=$(cat "$TSC_EXIT_FILE")
rm -rf "$TMP_DIR"

if [ "$TEST_EXIT" -ne 0 ]; then
  echo "❌ pre-commit FAILED: Unit tests or coverage threshold not met (index snapshot)."
  exit 1
fi
if [ "$TSC_EXIT" -ne 0 ]; then
  echo "❌ pre-commit FAILED: TypeScript type check errors (index snapshot)."
  exit 1
fi

echo "✅ pre-commit passed: G0 Lockfile + L1 Unit + G1 Static Analysis (Biome + TSC, index snapshot)"
