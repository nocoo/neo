#!/usr/bin/env sh

# === System0 gate: pre-commit ===
# Gates the Git index snapshot (not the working tree) with S1, S2, L1, G1 and —
# when workflows are staged — S3. See scripts/quality/slots.ts for the slot map.
set -e

stage_start=$(date +%s)

command -v git >/dev/null 2>&1 || {
	echo "pre-commit: git is required" >&2
	exit 1
}
command -v bun >/dev/null 2>&1 || {
	echo "pre-commit: bun is required" >&2
	exit 1
}

repo=$(git rev-parse --show-toplevel)

snapshot=
cleanup() {
	status=$?
	trap - EXIT INT TERM HUP
	if [ -n "$snapshot" ]; then
		rm -rf "$snapshot" || :
		snapshot=
	fi
	elapsed=$(( $(date +%s) - stage_start ))
	echo "pre-commit: wall ${elapsed}s (hard budget 30s)"
	if [ "$status" -eq 0 ] && [ "$elapsed" -gt 30 ]; then
		echo "pre-commit: wall time ${elapsed}s exceeds the 30s hard budget" >&2
		status=1
	fi
	exit "$status"
}
trap cleanup EXIT
trap "exit 130" INT
trap "exit 143" TERM
trap "exit 129" HUP

snapshot=$(mktemp -d "${TMPDIR:-/tmp}"/neo-index-XXXXXX)

GATE_STAGED_FILES=$(git diff --cached --name-only)
export GATE_STAGED_FILES

git checkout-index --all --prefix="$snapshot/"

if [ ! -f "$snapshot/package.json" ] || [ ! -f "$snapshot/bun.lock" ]; then
	echo "pre-commit: index must contain package.json and bun.lock" >&2
	exit 1
fi

# Install the exact snapshot from its own lockfile. Reusing the worktree's
# node_modules only compared manifests; it could not prove the installed
# versions matched the index. Lifecycle scripts stay disabled because the
# snapshot has no .git directory.
install_in() {
	if ! (cd "$1" && bun install --frozen-lockfile --ignore-scripts); then
		echo "pre-commit: isolated frozen install failed in $1" >&2
		echo "pre-commit: the index lockfile is authoritative; populate the Bun cache or configure a reachable registry" >&2
		exit 1
	fi
}

install_in "$snapshot"
if [ -f "$snapshot/worker/package.json" ] && [ -f "$snapshot/worker/bun.lock" ]; then
	install_in "$snapshot/worker"
fi

mkdir -p "$snapshot/node_modules/.vite" "$snapshot/node_modules/.vitest" "$snapshot/.cache"

unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX
unset GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
export XDG_CACHE_HOME="$snapshot/.cache"
export XDG_STATE_HOME="$snapshot/.cache"
export GATE_GIT_ROOT="$repo"
export GATE_SNAPSHOT_ROOT="$snapshot"

# The tree of the index is the version the slots below test.
GATE_CONTENT_SHA=$(git write-tree) || {
	echo "pre-commit: cannot read the index tree" >&2
	exit 1
}
export GATE_CONTENT_SHA

PATH="$snapshot/node_modules/.bin:$PATH"

export GATE_PREP_SECONDS=$(( $(date +%s) - stage_start ))

cd "$snapshot"
bun run scripts/quality/gate.ts --stage=pre-commit
